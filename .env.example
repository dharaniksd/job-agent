OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=
SERPAPI_KEY=
SECRET_KEY=change-me-in-production
APP_URL=http://localhost:3000

# Email — use SendGrid (recommended) or SMTP
SENDGRID_API_KEY=
EMAIL_FROM=noreply@jobagent.app
# SMTP fallback (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# LinkedIn OAuth
# Get these from https://www.linkedin.com/developers/apps → Create App
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
