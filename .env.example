# ── AI Provider ────────────────────────────────────────────────────────────────
# Default: Ollama (free, local, runs on your M3 Pro)
# Set USE_OPENAI=true to enable OpenAI as a fallback if Ollama is unavailable
USE_OPENAI=false
OPENAI_API_KEY=

# Ollama settings
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:14b

# ── Other optional keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SERPAPI_KEY=
SECRET_KEY=change-me-to-any-random-string
APP_URL=http://localhost:3000

# ── Email (optional) ───────────────────────────────────────────────────────────
# SendGrid (recommended)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@jobagent.app
# SMTP fallback (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# ── LinkedIn OAuth (optional) ──────────────────────────────────────────────────
# Get from https://www.linkedin.com/developers/apps → Create App
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
